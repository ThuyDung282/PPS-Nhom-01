import numpy as np

# PP CHIA ĐÔI
def bisection_steps(a: float, b: float, eps: float) -> int:
    """
    Tinh so buoc lap can thiet cua phuong phap chia doi de dat sai so eps.
    Dua tren danh gia sai so tien nghiem: (b - a) / (2^(n+1)) <= eps
    
    Require (Dau vao):
        a (float): Can duoi cua khoang phan ly nghiem.
        b (float): Can tren cua khoang phan ly nghiem.
        eps (float): Do chinh xac cho truoc (phai duong).
        
    Ensure (Dau ra):
        int: So buoc lap toi thieu n thoa man sai so <= eps.
        
    Thuat toan: Danh gia sai so phuong phap chia doi.
    """
    # R6: Xu ly tinh huong bien
    if eps <= 0:
        raise ValueError("Do chinh xac eps phai la mot so duong lon hon 0")
    if a >= b:
        raise ValueError("Can duoi a phai nho hon can tren b")
        
    # # Thuat toan - Dong 1 - Khoi tao so buoc lap ban dau n = 0
    n = 0
    # Sai so tai buoc ban dau n = 0 ung voi cong thuc: (b - a) / 2^(0+1) = (b - a) / 2
    err = (b - a) / 2  
    
    # # Thuat toan - Dong 2 - Vong lap danh gia sai so so voi dieu kien dung eps
    while err > eps:
        # # Thuat toan - Dong 3 - Tang so buoc lap len 1
        n += 1         
        # # Thuat toan - Dong 4 - Sai so tai buoc n tiep theo tuong ung voi: (b - a) / 2^(n+1)
        err = err / 2  
        
    # # Thuat toan - Dong 5 - Tra ve ket qua cuoi cung
    return n

# PP DÂY CUNG
def false_position_error(x_k, x_prev, m1, M1) -> float:
    """
    Đánh giá cận trên sai số của phương pháp dây cung qua 2 bước lặp liên tiếp.

    Thuật toán: Đánh giá sai số Dây cung (False Position Error)
    Công thức sai số: |x_k - x_star| <= ((M1 - m1) / m1) * |x_k - x_prev|

    Require(Đầu vào):
        x_k (float): Giá trị nghiệm xấp xỉ ở bước lặp thứ k
        x_prev (float): Giá trị nghiệm xấp xỉ ở bước lặp thứ k-1
        m1 (float): Cận dưới của |f'(x)| trên khoảng cách ly (m1 > 0)
        M1 (float): Cận trên của |f'(x)| trên khoảng cách ly (M1 >= m1)

    Ensure (Đầu ra):
        float: Giá trị cận trên sai số tuyệt đối tại bước lặp k
    """
    # dong 1 - Kiem tra dieu kien m1, M1
    if m1 <= 0:
        raise ValueError("Cận m1 phải lớn hơn 0")
    if M1 < m1:
        raise ValueError("Cận M1 phải lớn hơn hoặc bằng m1")

    # dong 2 - Tinh sai so theo cong thuc
    err = ((M1 - m1) / m1) * abs(x_k - x_prev)
    #dong 3 - Tra ve ket qua
    return float(err)
