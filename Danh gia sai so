import numpy as np

# PP CHIA ĐÔI
def bisection_steps(a, b, eps):
    """
    Tính số bước lặp tối thiểu của phương pháp chia đôi.

    Require:
        a, b: Khoảng cách ly nghiệm (a < b)
        eps: Độ chính xác yêu cầu (eps > 0)
    Ensure:
        Số bước lặp tối thiểu n (int)
    """
    # dong 1 - Kiem tra dieu kien dau vao
    if a >= b:
        raise ValueError("Khoảng cách ly không hợp lệ: yêu cầu b > a")
    if eps <= 0: 
        raise ValueError("Sai số eps phải lớn hơn 0")

    # dong 2 - Tinh so buoc lap
    n = np.ceil(np.log2((b - a) / eps)) - 1
    return max(0, int(n))


# PP DÂY CUNG
def false_position_error(x_k, x_prev, m1, M1):
    """
    Đánh giá sai số cận trên của phương pháp dây cung qua 2 bước lặp liên tiếp.

    Require:
        x_k, x_prev: Nghiệm xấp xỉ ở bước k và k-1
        m1, M1: Cận dưới và cận trên của |f'(x)| (0 < m1 <= M1)
    Ensure:
        Giá trị sai số tuyệt đối tại bước k (float)
    """
    # dong 1 - Kiem tra dieu kien m1, M1
    if m1 <= 0:
        raise ValueError("Cận m1 phải lớn hơn 0")
    if M1 < m1:
        raise ValueError("Cận M1 phải lớn hơn hoặc bằng m1")

    # dong 2 - Tinh sai so theo cong thuc
    err = ((M1 - m1) / m1) * abs(x_k - x_prev)
    return err