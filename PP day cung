
def false_position(f, a, b, eps, n_max) -> tuple[float, int, float]:
    """
    Tìm nghiệm gần đúng của f(x) = 0 bằng phương pháp dây cung.

    Require:
        f: Hàm số liên tục trên [a, b].
        a, b: Hai đầu mút, a < b.
        eps: Sai số cho phép, eps > 0.
        n_max: Số bước lặp tối đa, n_max là số nguyên dương.
        Hai đầu mút trái dấu, trừ khi một đầu mút là nghiệm.

    Ensure:
        Trả về (xn, i, err):
            xn: Nghiệm gần đúng.
            i: Số bước lặp đã thực hiện.
            err: Sai số giữa hai lần lặp liên tiếp.
        Cảnh báo nếu hết n_max bước mà chưa đạt eps.

    Algorithm:
        Phương pháp dây cung (Algorithm 6 trong giáo trình).
    """

    # Kiểm tra dữ liệu đầu vào
    if not callable(f):
        raise TypeError("f phải là một hàm số.")

    if a >= b:
        raise ValueError("Phải có a < b.")

    if eps <= 0:
        raise ValueError("eps phải lớn hơn 0.")

    if not isinstance(n_max, int) or isinstance(n_max, bool) or n_max < 1:
        raise ValueError("n_max phải là số nguyên dương.")

    # Tính giá trị hàm tại hai đầu mút
    fa = f(a)
    fb = f(b)

    # Xử lý trường hợp đầu mút là nghiệm
    if fa == 0:
        return float(a), 0, 0.0

    if fb == 0:
        return float(b), 0, 0.0

    # Kiểm tra điều kiện đổi dấu
    if fa * fb > 0:
        raise ValueError( "Khoảng [a, b] không thỏa mãn f(a)*f(b) < 0." )

   xn = 0.0
    err = 0.0

    # dong 1: for i = 1 -> n_max do
    for i in range(1, n_max + 1):

        # dong 2-3: nếu f(a) < 0 thì x0 <- a 
        if fa < 0:
            x0 = a

            # dong 4: Tính xn <- xn-1 - f(xn-1)*(xn-1 - b) / (f(xn-1) - f(b))
            mau_so = f(x0) - fb
            if mau_so == 0:
                raise ZeroDivisionError("Mẫu số bằng 0")
            xn = x0 - f(x0) * (x0 - b) / mau_so

        else:
            # dong 5-6: ngược lại , x0 <- b
            x0 = b

            # dong 7: Tính xn <- xn-1 - f(xn-1)*(xn-1 - a) / (f(xn-1) - f(a))
            mau_so = f(x0) - fa
            if mau_so == 0:
                raise ZeroDivisionError("Mẫu số bằng 0")
            xn = x0 - f(x0) * (x0 - a) / mau_so

        # dong 8: end if

        # dong 9: Tính err = |xn - x0|
        err = abs(xn - x0)

        # dong 10-11: nếu err < eps thì thuật toán dừng và in ra 
        if err < eps:
            return float(xn), i, float(err)

        # dong 12: end if 

        # Cập nhật lại khoảng tìm nghiệm [a, b] để thuật toán hội tụ
        fn = f(xn)
        if fa * fn < 0:
            b = xn
            fb = fn
        else:
            a = xn
            fa = fn

    # dong 13: end for
    # Hết số bước lặp tối đa mà chưa hội tụ
    import warnings
    warnings.warn("Chưa đạt sai số yêu cầu sau số bước lặp tối đa", RuntimeWarning)

    # dong 14: return xn , i, err
    return float(xn), n_max, float(err) 