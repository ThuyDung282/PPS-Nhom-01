# khoang phaan ly nghiem
import unittest

class TestIsolateRoots(unittest.TestCase):
    """Bo kiem thu ham tim khoang phan ly nghiem cua SV1."""

    # TC01: Ham co nghiem nam trong khoang quet
    def test_TC01(self):
        f = lambda x: x**2 - 2
        self.assertEqual(
            isolate_roots(f, 0, 2, 0.5),
            [(1.0, 1.5)]
        )

    # TC02: Nghiem nam giua hai diem quet
    def test_TC02(self):
        f = lambda x: x - 1.5
        self.assertEqual(
            isolate_roots(f, 0, 2, 1),
            [(1.0, 2.0)]
        )

    # TC03: Ham khong co nghiem thuc
    def test_TC03(self):
        f = lambda x: x**2 + 1
        self.assertEqual(
            isolate_roots(f, 0, 2, 0.5),
            []
        )

    # TC04: Nghiem tai dau mut trai
    def test_TC04(self):
        f = lambda x: x
        self.assertEqual(
            isolate_roots(f, 0, 2, 0.5),
            [(0.0, 0.0)]
        )

    # TC05: Nghiem tai dau mut phai
    # Test nay du kien that bai voi code hien tai
    def test_TC05(self):
        f = lambda x: x - 2
        self.assertEqual(
            isolate_roots(f, 0, 2, 0.5),
            [(2.0, 2.0)]
        )

    # TC06: Ham co hai nghiem tren doan
    def test_TC06(self):
        f = lambda x: x**2 - 4
        self.assertEqual(
            isolate_roots(f, -3, 3, 1),
            [(-2.0, -2.0), (2.0, 2.0)]
        )

    # TC07: Buoc quet khong chia het do dai doan
    def test_TC07(self):
        f = lambda x: x - 1
        self.assertEqual(
            isolate_roots(f, 0, 2.5, 1),
            [(1.0, 1.0)]
        )

    # TC08: a lon hon b
    def test_TC08(self):
        with self.assertRaises(ValueError):
            isolate_roots(lambda x: x, 2, 1, 0.5)

    # TC09: step bang 0
    def test_TC09(self):
        with self.assertRaises(ValueError):
            isolate_roots(lambda x: x, 0, 2, 0)

    # TC10: step am
    def test_TC10(self):
        with self.assertRaises(ValueError):
            isolate_roots(lambda x: x, 0, 2, -1)


if __name__ == "__main__":
    unittest.main(argv=['first-arg-is-ignored'], exit=False, verbosity=2)
