Bài toán ứng dụng: lãi suất vay trả góp.

Một người vay P triệu đồng, trả đều A triệu đồng mỗi tháng trong N tháng.
Lãi suất tháng r là nghiệm của phương trình

    f(r) = A * (1 - (1 + r)^(-N)) / r - P = 0.

GỌI các hàm của nhóm :
    P1 isolate_roots  : tách khoảng chứa nghiệm
    P2 bisection      : phương pháp chia đôi
    P3 false_position : phương pháp dây cung
    P4 bisection_steps: số bước chia đôi theo lý thuyết

Chạy:  python ung_dung.py

import matplotlib.pyplot as plt
import numpy as np

from bisection import bisection                 # P2
from danh_gia_sai_so import bisection_steps     # P4
from false_position import false_position       # P3
from isolate_roots import isolate_roots         # P1

# Số liệu của đề bài
P = 500.0      # số tiền vay (triệu đồng)
A = 12.0       # tiền trả mỗi tháng (triệu đồng)
N = 60         # số tháng
EPS = 10^-8     # sai số yêu cầu
N_MAX = 200    # số bước lặp tối đa

# 1. Mô hình hóa
def f_lai_suat(r, A, P, N):
    """Tính f(r) = A*(1 - (1+r)^(-N))/r - P.

    Ý nghĩa: A*(1 - (1+r)^(-N))/r là tổng giá trị hiện tại của N lần trả A,
    nên f(r) = 0 khi giá trị hiện tại đó đúng bằng số tiền vay P.

    Require:
        r : lãi suất tháng, r > 0 (r = 0 làm mẫu số bằng 0)
        A, P : số thực dương;  N : số nguyên dương
    Ensure:
        Trả về f(r) (float).
    Thuật toán: không phải thuật toán bài giảng, đây là hàm mục tiêu của bài toán.
    """
    if r <= 0:  # điều kiện áp dụng: chia cho r nên cần r > 0
        raise ValueError("Cần r > 0.")
    return A * (1 - (1 + r) ** (-N)) / r - P

def kiem_tra_tham_so(A, P, N):
    """Kiểm tra dữ liệu đầu vào (R6).

    Require: A, P, N là các số.
    Ensure: không trả về gì; báo ValueError nếu A <= 0, P <= 0 hoặc N không là số nguyên dương.
    """
    if A <= 0 or P <= 0:
        raise ValueError("A và P phải dương.")
    if int(N) != N or N < 1:
        raise ValueError("N phải là số nguyên dương.")

# 2. Tìm khoảng chứa nghiệm (dùng P1) và giải (dùng P2, P3)
def tim_khoang_nghiem(A, P, N, step=0.01):
    """Tìm khoảng [a; b] chứa nghiệm r > 0 của f(r) = 0 bằng isolate_roots (P1).

    Vì sao quét r trong [10^-6; 1]?
      - f giảm theo r; khi r -> 0+ thì f -> A*N - P; khi r lớn thì f -> -P < 0.
      - Nên nếu A*N > P thì f đổi dấu đúng một lần với r > 0.
      - Bắt đầu từ 10^-6 (không phải 0) để tránh chia cho 0; r = 1 là 100%/tháng, đủ lớn.
      - Nếu A*N <= P thì f(r) < 0 với mọi r > 0, không có lãi suất dương -> báo lỗi.

    Require: A, P > 0; N nguyên dương; step > 0.
    Ensure: trả về (a, b) với f(a)*f(b) < 0.
    Raises: ValueError nếu A*N <= P hoặc không tách được nghiệm.
    Thuật toán: tách nghiệm bằng quét dấu (P1).
    """
    kiem_tra_tham_so(A, P, N)
    if A * N <= P + 10^-9:  # tình huống biên: tổng tiền trả không vượt số tiền vay (+1e-9 để bù sai số làm tròn)
        raise ValueError("A*N <= P: tổng tiền trả không vượt số tiền vay, không có lãi suất dương.")

    def f(r):
        return f_lai_suat(r, A, P, N)

    cac_khoang = isolate_roots(f, 1e-6, 1.0, step)  # dùng P1
    if len(cac_khoang) == 0:
        raise ValueError("Không tách được khoảng chứa nghiệm trong [1e-6; 1].")
    return cac_khoang[0]  # f đơn điệu nên chỉ có một khoảng


def giai_lai_suat(A, P, N, eps, n_max, phuong_phap):
    """Tìm lãi suất tháng r bằng chia đôi hoặc dây cung.

    Require:
        A, P > 0; N nguyên dương; eps > 0; n_max >= 1
        phuong_phap : "chia_doi" hoặc "day_cung"
    Ensure:
        Trả về (r, k, err): nghiệm xấp xỉ, số bước lặp, sai số (do P2/P3 trả về).
    Thuật toán: chia đôi (P2) hoặc dây cung (P3).
    """
    a, b = tim_khoang_nghiem(A, P, N)  # bước 1: tách nghiệm (P1)

    def f(r):
        return f_lai_suat(r, A, P, N)

    if phuong_phap == "chia_doi":  # bước 2: giải bằng P2
        return bisection(f, a, b, eps, n_max)
    if phuong_phap == "day_cung":  # bước 2: giải bằng P3
        return false_position(f, a, b, eps, n_max)
    raise ValueError('phuong_phap phải là "chia_doi" hoặc "day_cung".')

# 3. Khảo sát khi A thay đổi
def khao_sat(danh_sach_A, P, N, eps, n_max):
    """Giải bằng cả hai phương pháp với từng giá trị A.

    Require: danh_sach_A gồm các số thỏa A*N > P; P, N, eps, n_max hợp lệ.
    Ensure: trả về danh sách các bộ (A, r_chia_doi, k_chia_doi, r_day_cung, k_day_cung).
    """
    ket_qua = []
    for a_i in danh_sach_A:
        r_cd, k_cd, _ = giai_lai_suat(a_i, P, N, eps, n_max, "chia_doi")
        r_dc, k_dc, _ = giai_lai_suat(a_i, P, N, eps, n_max, "day_cung")
        ket_qua.append((float(a_i), r_cd, k_cd, r_dc, k_dc))
    return ket_qua

def in_bang(ket_qua):
    """In bảng kết quả khảo sát. Require: ket_qua từ khao_sat. Ensure: in ra màn hình."""
    print(f"{'A':>6} {'A*N':>6} {'r chia đôi (%)':>15} {'k':>3} {'r dây cung (%)':>15} {'k':>3}")
    for a_i, r_cd, k_cd, r_dc, k_dc in ket_qua:
        print(f"{a_i:6.1f} {a_i * N:6.0f} {100 * r_cd:15.6f} {k_cd:3d} {100 * r_dc:15.6f} {k_dc:3d}")

def ve_do_thi(ket_qua, ten_file="khao_sat_lai_suat.png"):
    """Vẽ r theo A và số bước lặp theo A, lưu ra file ảnh.

    Require: ket_qua từ khao_sat; ten_file là tên file ảnh.
    Ensure: tạo file ảnh tại ten_file.
    """
   a_ds = [d[0] for d in ket_qua]        # danh sách các giá trị A: 9, 9.5, ..., 15
   r_cd = [100 * d[1] for d in ket_qua]  # r của chia đôi, nhân 100 để đổi sang %
   r_dc = [100 * d[3] for d in ket_qua]  # r của dây cung, cũng đổi sang %
   k_cd = [d[2] for d in ket_qua]        # số bước lặp của chia đôi
   k_dc = [d[4] for d in ket_qua]        # số bước lặp của dây cung

    fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(11, 4))

    ax1.plot(a_ds, r_cd, "o-", label="Chia đôi")   # vẽ đường: trục x là A, trục y là r
    ax1.plot(a_ds, r_dc, "x--", label="Dây cung")  # đường thứ hai
    ax1.set_xlabel("A (triệu đồng/tháng)")         # tên trục ngang
    ax1.set_ylabel("r (%/tháng)")                  # tên trục dọc
    ax1.set_title("Lãi suất tháng r theo tiền trả A")  
    ax1.grid(True)                                 # bật lưới 
    ax1.legend()                                   # hiện chú thích (dùng các label ở trên)

    ax2.plot(a_ds, k_cd, "o-", label="Chia đôi")
    ax2.plot(a_ds, k_dc, "x--", label="Dây cung")
    ax2.set_xlabel("A (triệu đồng/tháng)")
    ax2.set_ylabel("Số bước lặp k")
    ax2.set_title("Số bước lặp với eps = 10^-8")
    ax2.grid(True)
    ax2.legend()
   
    fig.tight_layout()                # tự chỉnh khoảng cách để chữ không đè lên nhau
    fig.savefig(ten_file)             # lưu ra file ảnh
    plt.close(fig)                    # đóng hình, giải phóng bộ nhớ

# 4. Chương trình chính
def main():
    Chạy toàn bộ bài toán ứng dụng và in kết quả.
    # Phần 1: A = 12, giải bằng hai phương pháp
    a, b = tim_khoang_nghiem(A, P, N)
    print(f"[1] Khoảng chứa nghiệm (P1): [{a:.6f}; {b:.6f}]")
    print(f"    Số bước chia đôi theo lý thuyết (P4): {bisection_steps(a, b, EPS)}")
    for ten in ("chia_doi", "day_cung"):
        r, k, err = giai_lai_suat(A, P, N, EPS, N_MAX, ten)
        print(f"    {ten:9s}: r = {100 * r:.6f} %/tháng, k = {k}, "
              f"err = {err:.2e}, |f(r)| = {abs(f_lai_suat(r, A, P, N)):.2e}")
    print("    Đáp số của đề: r ≈ 1,2833 %/tháng")

    # Phần 2: khảo sát A từ 9 đến 15 
    danh_sach_A = np.arange(9.0, 15.0 + 1e-9, 0.5)
    ket_qua = khao_sat(danh_sach_A, P, N, EPS, N_MAX)
    print("\n[2] Khảo sát r khi A thay đổi từ 9 đến 15:")
    in_bang(ket_qua)
    ve_do_thi(ket_qua)
    print("    Đã lưu đồ thị: khao_sat_lai_suat.png")

    # Phần 3: tình huống A*N <= P
    print(f"\n[3] Tình huống A*N <= P (P = {P:.0f}, N = {N}, nên A <= {P / N:.3f}):")
    for a_loi in (8.0, P / N):
        try:
            giai_lai_suat(a_loi, P, N, EPS, N_MAX, "chia_doi")
        except ValueError as loi:
            print(f"    A = {a_loi:.3f} (A*N = {a_loi * N:.1f}): báo lỗi -> {loi}")

if __name__ == "__main__":
    main()

"""Kiểm thử phần ứng dụng. Chạy: pytest"""
import pytest

from ung_dung import f_lai_suat, giai_lai_suat, tim_khoang_nghiem

P, A, N = 500.0, 12.0, 60
EPS = 10^-8

# TH1: ví dụ trong đề (r ≈ 1,2833 %/tháng) 
@pytest.mark.parametrize("phuong_phap", ["chia_doi", "day_cung"])
def test_vi_du_de_bai(phuong_phap):
    r, k, err = giai_lai_suat(A, P, N, EPS, 200, phuong_phap)
    assert r == pytest.approx(0.012833, abs=1e-5)   # đề chỉ cho 5 chữ số
    assert abs(f_lai_suat(r, A, P, N)) < 1e-3       # thay lại vào f thì f(r) ≈ 0
    assert k >= 1 and err >= 0


# TH2: có nghiệm đúng do nhóm chọn: chọn trước r = 1%/tháng, tính A tương ứng 
@pytest.mark.parametrize("phuong_phap", ["chia_doi", "day_cung"])
def test_nghiem_dung_tu_chon(phuong_phap):
    r_dung = 0.01
    A_chon = P * r_dung / (1 - (1 + r_dung) ** (-N))  # công thức trả góp: f(r_dung) = 0
    r, _, _ = giai_lai_suat(A_chon, P, N, EPS, 200, phuong_phap)
    assert r == pytest.approx(r_dung, abs=1e-7)


# TH3: ca biên A*N <= P (không có lãi suất dương) -> phải báo lỗi
def test_bien_AN_nho_hon_hoac_bang_P():
    with pytest.raises(ValueError):
        giai_lai_suat(8.0, P, N, EPS, 200, "chia_doi")      # A*N = 480 < 500
    with pytest.raises(ValueError):
        giai_lai_suat(P / N, P, N, EPS, 200, "day_cung")    # A*N = P


# Các TH bổ sung
def test_hai_phuong_phap_cho_cung_ket_qua():
    r_cd, _, _ = giai_lai_suat(A, P, N, EPS, 200, "chia_doi")
    r_dc, _, _ = giai_lai_suat(A, P, N, EPS, 200, "day_cung")
    assert abs(r_cd - r_dc) < 1e-7


def test_A_tang_thi_r_tang():
    """Cùng vay P, trả mỗi tháng nhiều hơn thì lãi suất r phải lớn hơn."""
    cac_r = [giai_lai_suat(a, P, N, EPS, 200, "chia_doi")[0] for a in range(9, 16)]
    assert all(cac_r[i] < cac_r[i + 1] for i in range(len(cac_r) - 1))


def test_khoang_nghiem_doi_dau():
    a, b = tim_khoang_nghiem(A, P, N)
    assert a < b
    assert f_lai_suat(a, A, P, N) * f_lai_suat(b, A, P, N) < 0


def test_tham_so_khong_hop_le():
    with pytest.raises(ValueError):
        giai_lai_suat(-1.0, P, N, EPS, 200, "chia_doi")     # A âm
    with pytest.raises(ValueError):
        giai_lai_suat(A, P, 0, EPS, 200, "chia_doi")        # N = 0
    with pytest.raises(ValueError):
        giai_lai_suat(A, P, N, EPS, 200, "newton")          # phương pháp lạ
    with pytest.raises(ValueError):
        f_lai_suat(0.0, A, P, N)                            # r = 0

"""Kiểm thử hai bài tập ứng dụng bổ sung. Chạy: pytest"""
import math
import pytest

from bisection import bisection
from danh_gia_sai_so import bisection_steps
from ung_dung_them import bang_so_sanh, f_bai1, f_bai2, nghiem_duong_nho_nhat

# Bài 1 (Ví dụ 3.1)
def test_bai1_khop_vi_du_trong_sach():
    """Sách: sau 6 bước x6 = 1,4140625, sai số 0,0078125."""
    x, k, err = bisection(f_bai1, 1, 2, 0.01, 50)
    assert x == pytest.approx(1.4140625)
    assert k == 6
    assert err == pytest.approx(0.0078125)

def test_bai1_so_buoc_ly_thuyet():
    """Sách: với eps = 1e-5 cần ít nhất 16 bước, và chạy thực tế cũng đúng 16 bước."""
    assert bisection_steps(1, 2, 1e-5) == 16
    assert bisection(f_bai1, 1, 2, 1e-5, 50)[1] == 16

def test_bai1_hai_phuong_phap_gan_can_bac_hai_cua_2(): #so sánh hiệu quả giữa hai phương pháp
    (eps, x_cd, k_cd, k_lt, x_dc, k_dc), = bang_so_sanh(f_bai1, 1, 2, [1e-8], 200)
    assert x_cd == pytest.approx(math.sqrt(2), abs=1e-7)
    assert x_dc == pytest.approx(math.sqrt(2), abs=1e-7)
    assert k_dc < k_cd  # dây cung ít bước hơn chia đôi

# Bài 2 (Bài tập 3.10)
def test_bai2_khoang_chua_nghiem_duong_nho_nhat():
    a, b = nghiem_duong_nho_nhat(f_bai2, 0.0, 5.0, 0.5)
    assert f_bai2(a) * f_bai2(b) < 0
    # không có nghiệm nào nhỏ hơn: f dương trên cả đoạn [0; a]
    assert all(f_bai2(a * i / 100) > 0 for i in range(101))

@pytest.mark.parametrize("eps", [1e-2, 1e-5, 1e-8])
#Kiểm tra nghiệm tìm được từ cả hai phuong pháp chia đôi và dây cung
