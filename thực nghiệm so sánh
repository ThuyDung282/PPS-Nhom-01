# 4. VẼ ĐỒ THỊ (3 BÀI -> 6 ĐỒ THỊ RIÊNG BIỆT TRÊN THANG LOG)
def get_history_bi(f, a, b, n_steps=30):
    aa, bb = a, b
    xs = []
    for _ in range(n_steps):
        x = (aa + bb) / 2
        xs.append(x)
        if f(aa) * f(x) > 0: aa = x
        else: bb = x
    return xs

def get_history_fp(f, a, b, n_steps=30):
    ak, bk = a, b
    fak, fbk = f(ak), f(bk)
    xs = []
    for _ in range(n_steps):
        x = bk - fbk * (bk - ak) / (fbk - fak)
        xs.append(x)
        if fak * f(x) < 0: bk, fbk = x, f(x)
        else: ak, fak = x, f(x)
    return xs

for idx, bt in enumerate(danh_sach_bai_toan, 1):
    xs_bi = get_history_bi(bt["f"], bt["a"], bt["b"], 30)
    xs_fp = get_history_fp(bt["f"], bt["a"], bt["b"], 30)

    sai_bi = [max(abs(x - bt["x_star"]), 1e-16) for x in xs_bi]
    sai_fp = [max(abs(x - bt["x_star"]), 1e-16) for x in xs_fp]

    # Đồ thị Phương pháp Chia đôi
    plt.figure(figsize=(6, 4))
