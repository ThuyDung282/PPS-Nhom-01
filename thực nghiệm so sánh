# 1. CÁC HÀM CƠ SỞ THEO ĐỀ BÀI
def isolate_roots(f, a, b, step) -> list[tuple[float, float]]:
    """P1: Tìm khoảng cách ly nghiệm bằng quét dấu (Incremental Search)."""
    if a >= b:
        raise ValueError("Lỗi biên: Biên trái 'a' phải nhỏ hơn biên phải 'b'.")
    if step <= 0:
        raise ValueError("Lỗi biên: Bước quét 'step' phải là số thực dương (> 0).")
    
    intervals = []
    x_curr = float(a)
    y_curr = f(x_curr)
    
    while x_curr < b:
        x_next = min(x_curr + step, float(b))
        y_next = f(x_next)
        if y_curr * y_next < 0:
            intervals.append((x_curr, x_next))
        elif y_curr == 0:
            intervals.append((x_curr, x_curr))
        x_curr = x_next
        y_curr = y_next
        
    if f(b) == 0:
        val_b = float(b)
        if not intervals or intervals[-1] != (val_b, val_b):
            intervals.append((val_b, val_b))
            
    return intervals

def bisection_steps(a, b, eps) -> int:
    """P4: Đánh giá số bước lặp lý thuyết tối thiểu của phương pháp chia đôi."""
    if a >= b:
        raise ValueError("Khoảng cách ly không hợp lệ: yêu cầu b > a")
    if eps <= 0:
        raise ValueError("Sai số eps phải lớn hơn 0")
    n = np.ceil(np.log2((b - a) / eps)) - 1
    return max(0, int(n))

def bisection(f, a, b, eps=1e-5, n_max=50) -> tuple[float, int, float]:
    """P2: Phương pháp Chia đôi."""
    if not a < b:
        raise ValueError("Cần a < b.")
    if eps <= 0:
        raise ValueError("Sai số eps phải dương.")
    if n_max < 0:
        raise ValueError("n_max phải không âm.")
        
    fa = f(a)
    fb = f(b)
    if fa == 0: return float(a), 0, 0.0
    if fb == 0: return float(b), 0, 0.0
    if fa * fb > 0:
        raise ValueError("f(a)f(b) > 0: (a, b) không phải khoảng phân ly nghiệm.")
        
    i = 0
    err = (b - a) / 2
    x = (a + b) / 2
    
    while err > eps and i < n_max:
        i += 1
        x = (a + b) / 2
        fx = f(x)
        if fa * fx == 0:
            return x, i, 0.0
        elif fa * fx > 0:
            a = x
            fa = fx
            err = (b - a) / 2
        else:
            b = x
            err = (b - a) / 2
            
    x = (a + b) / 2
    err = (b - a) / 2
    return float(x), i, float(err)

def false_position(f, a, b, eps=1e-5, n_max=50) -> tuple[float, int, float]:
    """P3: Phương pháp Dây cung (Regula Falsi)."""
    fa, fb = f(a), f(b)
    if fa * fb > 0:
        raise ValueError("Khoảng [a, b] không thỏa mãn điều kiện đổi dấu.")
    
    a_k, b_k = a, b
    fa_k, fb_k = fa, fb
    k = 0
    
    while k < n_max:
        k += 1
        x = b_k - fb_k * (b_k - a_k) / (fb_k - fa_k)
        fx = f(x)
        err = abs(b_k - a_k)
        if abs(fx) < eps or err < eps:
            return float(x), k, float(err)
        if fa_k * fx < 0:
            b_k = x
            fb_k = fx
        else:
            a_k = x
            fa_k = fx
    return float(x), k, float(err)


